---

{
      page.lastPage > 1 && (
            <nav class="mt-auto mb-8 flex justify-center gap-4" role="navigation" aria-label="Pagination Navigation">
                  {page.url.prev ? (
                            <a
                                      href={getSafeUrl(page.url.prev)}
                                                class="group inline-block select-none hover:text-skin-accent"
                                                          aria-label={t.a11y.goToPreviousPage}
                                                                    data-astro-reload
                                                                            >
                                                                                      <IconArrowLeft class="inline-block rtl:rotate-180" />
                                                                                                {t.pagination.prev}
                                                                                                        </a>
                  ) : (
                            <span class="group inline-block select-none opacity-50" aria-label={t.a11y.goToPreviousPage}>
                                      <IconArrowLeft class="inline-block rtl:rotate-180" />
                                                {t.pagination.prev}
                                                        </span>
                  )}

                        {page.currentPage} / {page.lastPage}

                              {page.url.next ? (
                                        <a
                                                  href={getSafeUrl(page.url.next)}
                                                            class="group inline-block select-none hover:text-skin-accent"
                                                                      aria-label={t.a11y.goToNextPage}
                                                                                data-astro-reload
                                                                                        >
                                                                                                  {t.pagination.next}
                                                                                                            <IconArrowRight class="inline-block rtl:rotate-180" />
                                                                                                                    </a>
                              ) : (
                                        <span class="group inline-block select-none opacity-50" aria-label={t.a11y.goToNextPage}>
                                                  {t.pagination.next}
                                                            <IconArrowRight class="inline-block rtl:rotate-180" />
                                                                    </span>
                              )}
                                  </nav>
      )
}
