---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

export interface Props {
      page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;
const t = useTranslations(Astro.currentLocale);

// KESİN ÇÖZÜM: Yönlendirmeyi doğrudan tam URL (Absolute Path) ile yapıyoruz.
const getSafeUrl = (url: string | undefined) => {
      if (!url) return "#";
        let cleanUrl = url.replace("/tr/kilavuz", "");
          if (!cleanUrl.startsWith("/")) cleanUrl = "/" + cleanUrl;
            return "https://www.attestprime.com/tr/kilavuz" + cleanUrl;
};
---

{
      page.lastPage > 1 && (
        <nav class="mt-auto mb-8 flex justify-center gap-4" role="navigation" aria-label="Pagination Navigation">
              <LinkButton
                      disabled={!page.url.prev}
                              href={getSafeUrl(page.url.prev)}
                                      class:list={["select-none", { "opacity-50": !page.url.prev }]}
                                              aria-label={t.a11y.goToPreviousPage}
                                                      data-astro-reload
                                                            >
                                                                    <IconArrowLeft class="inline-block rtl:rotate-180" />
                                                                            {t.pagination.prev}
                                                                                  </LinkButton>

                                                                                        {page.currentPage} / {page.lastPage}

                                                                                              <LinkButton
                                                                                                      disabled={!page.url.next}
                                                                                                              href={getSafeUrl(page.url.next)}
                                                                                                                      class:list={["select-none", { "opacity-50": !page.url.next }]}
                                                                                                                              aria-label={t.a11y.goToNextPage}
                                                                                                                                      data-astro-reload
                                                                                                                                            >
                                                                                                                                                    {t.pagination.next}
                                                                                                                                                            <IconArrowRight class="inline-block rtl:rotate-180" />
                                                                                                                                                                  </LinkButton>
                                                                                                                                                                      </nav>
                                                                                                                                                                      
      )
}